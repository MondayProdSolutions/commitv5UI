# Local, non-secret defaults (embedded Postgres). Copy to .env for local dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/pos_dev?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:54330/pos_test?schema=public"
DATABASE_URL_E2E="postgresql://postgres:postgres@localhost:54330/pos_e2e?schema=public"
ATTENDANCE_PHOTOS_DIR=".attendance-photos"
# Tamaño del pool de conexiones a Postgres (default 20 si se omite, ver
# src/lib/db.ts). Cada navegación autenticada consume 2-3 conexiones por
# diseño (proxy.ts + render de página), así que debe escalar con usuarios
# concurrentes reales y quedar por debajo de max_connections de Postgres.
DB_POOL_MAX=

# Asistente de IA embebido (soporte y capacitación). GEMINI_API_KEY es secreto:
# ponlo solo en tu .env local, nunca aquí ni en el repo.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-flash-latest"
# Opcionales: se muestran al usuario cuando el asistente no puede resolver algo.
SUPPORT_EMAIL=
SUPPORT_PHONE=
